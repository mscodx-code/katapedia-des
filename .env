# Katapedia DES Environment Configuration
# Salin berkas ini ke .env untuk menjalankan sistem

# General Environment
APP_ENV=development
NODE_ENV=development
PORT=4100
PUBLIC_APP_URL=http://localhost:8080

# Frontend Variables (Public)
VITE_API_BASE_URL=http://localhost:4100/api/v1
VITE_APP_NAME="Katapedia DES"

# Database & Cache
DATABASE_URL="postgresql://miftahsyarief@localhost:5432/katapedia_des?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & Session
SESSION_SECRET="katapedia-super-secret-session-key-development-minimum-32-chars-long"
STORAGE_PATH="./storage"

# AI Integration
AI_PROVIDER=ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

AI_CONCURRENCY=1
AI_TIMEOUT_MS=120000

# Limits & System Config
MAX_UPLOAD_MB=20
DEFAULT_TIMEZONE="Asia/Jakarta"
LOG_LEVEL="info"

# SMTP (Opsional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
